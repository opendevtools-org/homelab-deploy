# Copy to .env and fill in. Do not commit .env.

# Rolling tags while in test/dev (overwrite on each publish). Pin semver later for real releases.
HOMELAB_VERSION=latest
PKM_VERSION=latest

# Hub Platform
PLATFORM_SERVICE_TOKEN=generate-a-long-random-token
HUB_JWT_SECRET=generate-a-long-random-secret
HUB_ADMIN_USERNAME=admin
HUB_ADMIN_PASSWORD=changeme
HUB_ADMIN_EMAIL=admin@localhost
HUB_BUILTIN_PLUGINS=pkm
PUBLIC_PKM_URL=http://127.0.0.1:3030/
# Local Hub catalog uses this port in localUrls (override if PKM UI is remapped).
# BUILTIN_PKM_PORT=3030
# Web clients on the same host use Docker DNS (hub-platform / pkm-backend).
# On another device, add docker-compose.frontend.remote.yml and set:
# HUB_API_UPSTREAM=http://192.168.1.10:8090
# PKM_API_UPSTREAM=http://192.168.1.10:8001
#
# Optional LAN HTTPS (docker-compose.https.yml). Clipboard paste of images
# needs a secure context: HTTPS or localhost, not a VPN/LAN HTTP URL.
# HUB_HOSTNAME=hub.home.arpa
# PKM_HOSTNAME=pkm.home.arpa
# PUBLIC_PKM_URL=https://pkm.home.arpa/
# PUBLIC_PKM_URL_HTTP=http://192.168.1.10:3030/
# HUB_COOKIE_SECURE=true
# Optional: GitHub token for private market sources
GITHUB_TOKEN=

# Optional: local hub-community-plugins checkout. If that folder has catalog.json,
# Market reads it instead of GitHub (test plugins before publishing).
# HUB_MARKET_PLUGINS_HOST=./community-plugins

# PKM
JWT_SECRET=generate-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
PUID=1000
PGID=1000

# Optional: non-interactive Git push for Backup-DataGit / Pull-DataGit
# Requires an HTTPS origin remote. Leave empty to use host git credentials.
HOMELAB_GIT_USERNAME=
HOMELAB_GIT_PAT=

# After Backup-DataGit / Pull-DataGit, restart PKM and import pages/files/PDFs/bookmarks from disk.
# Set to false to skip. Container name if you renamed it: HOMELAB_PKM_CONTAINER=pkm-backend
# HOMELAB_PKM_REINDEX_AFTER_SYNC=true
