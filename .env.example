# Copy to .env and fill in. Do not commit .env.

# Rolling tags while in test/dev (overwrite on each publish). Pin semver later for real releases.
HOMELAB_VERSION=latest
PKM_VERSION=latest

# Hub Platform
PLATFORM_SERVICE_TOKEN=generate-a-long-random-token
HUB_JWT_SECRET=generate-a-long-random-secret
HUB_ADMIN_USERNAME=admin
HUB_ADMIN_PASSWORD=changeme
HUB_ADMIN_EMAIL=admin@localhost
HUB_BUILTIN_PLUGINS=pkm
PUBLIC_PKM_URL=http://127.0.0.1:3030/
# Local Hub catalog uses this port in localUrls (override if PKM UI is remapped).
# BUILTIN_PKM_PORT=3030
# Web clients on the same host use Docker DNS (hub-platform / pkm-backend).
# On another device, add docker-compose.frontend.remote.yml and set:
# HUB_API_UPSTREAM=http://192.168.1.10:8090
# PKM_API_UPSTREAM=http://192.168.1.10:8001
# Optional: GitHub token for private market sources
GITHUB_TOKEN=

# PKM
JWT_SECRET=generate-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
PUID=1000
PGID=1000

# Optional: non-interactive Git push for Backup-DataGit / Pull-DataGit
# Requires an HTTPS origin remote. Leave empty to use host git credentials.
HOMELAB_GIT_USERNAME=
HOMELAB_GIT_PAT=
